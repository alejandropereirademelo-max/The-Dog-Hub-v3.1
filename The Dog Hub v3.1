-- ESP para Blox Fruits - Nome, Level e Bounty/Belo
-- Compatível com a maioria dos executors

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Cache para performance
local espCache = {}
local connections = {}

-- Configurações do ESP
local ESP_Settings = {
    Enabled = true,
    ShowName = true,
    ShowLevel = true,
    ShowBounty = true,
    ShowDistance = true,
    ShowTeamColor = true,
    MaxDistance = 1500,
    TextSize = 14,
    TextFont = 2, -- 0=Legacy, 1=System, 2=Black
    TextOutline = true,
    
    -- Cores baseadas no level
    ColorLowLevel = Color3.fromRGB(0, 255, 0),      -- Verde (baixo)
    ColorMidLevel = Color3.fromRGB(255, 255, 0),    -- Amarelo (médio)
    ColorHighLevel = Color3.fromRGB(255, 50, 50),   -- Vermelho (alto)
    ColorMaxLevel = Color3.fromRGB(255, 0, 255),    -- Magenta (máximo)
    
    LevelThresholds = {
        Low = 500,
        Mid = 1000,
        High = 2000
    }
}

-- Função para obter informações do jogador
local function getPlayerStats(player)
    local stats = {
        level = 0,
        bounty = 0,
        frags = 0,
        race = "?",
        fruit = "?"
    }
    
    -- Verificar leaderstats
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        -- Level
        local lvlStat = leaderstats:FindFirstChild("Level") 
        if not lvlStat then
            lvlStat = leaderstats:FindFirstChild("Lvl") 
        end
        if not lvlStat then
            lvlStat = leaderstats:FindFirstChild("Lv") 
        end
        if lvlStat then
            stats.level = tonumber(lvlStat.Value) or 0
        end
        
        -- Bounty/Belo
        local bountyStat = leaderstats:FindFirstChild("Bounty") 
        if not bountyStat then
            bountyStat = leaderstats:FindFirstChild("Belo") 
        end
        if not bountyStat then
            bountyStat = leaderstats:FindFirstChild("Honor") 
        end
        if bountyStat then
            stats.bounty = tonumber(bountyStat.Value) or 0
        end
        
        -- Frags/Mortes
        local fragStat = leaderstats:FindFirstChild("Kills") 
        if not fragStat then
            fragStat = leaderstats:FindFirstChild("Frags") 
        end
        if not fragStat then
            fragStat = leaderstats:FindFirstChild("Deaths") 
        end
        if fragStat then
            stats.frags = tonumber(fragStat.Value) or 0
        end
    end
    
    -- Tentar encontrar informações extras
    if player.Character then
        -- Verificar se tem fruta equipada
        local backpack = player:FindFirstChild("Backpack")
        if backpack then
            for _, item in pairs(backpack:GetChildren()) do
                if item:IsA("Tool") then
                    local itemName = item.Name:lower()
                    if itemName:find("fruit") or itemName:find("blox") then
                        stats.fruit = item.Name
                        break
                    end
                end
            end
        end
        
        -- Verificar race (raça)
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local bodyColors = humanoid:FindFirstChild("BodyColors")
            if bodyColors then
                -- Tentar identificar a raça pela cor
                local headColor = bodyColors.HeadColor3
                if headColor then
                    -- Mink (azul)
                    if headColor == Color3.fromRGB(0, 162, 255) then
                        stats.race = "Mink"
                    -- Fishman (verde/azul)
                    elseif headColor == Color3.fromRGB(0, 255, 162) then
                        stats.race = "Fishman"
                    -- Cyborg (cinza)
                    elseif headColor == Color3.fromRGB(162, 162, 162) then
                        stats.race = "Cyborg"
                    else
                        stats.race = "Human"
                    end
                end
            end
        end
    end
    
    return stats
end

-- Função para formatar números grandes
local function formatNumber(num)
    if num >= 1000000 then
        return string.format("%.1fM", num/1000000)
    elseif num >= 1000 then
        return string.format("%.1fK", num/1000)
    end
    return tostring(num)
end

-- Função para determinar a cor baseada no level
local function getLevelColor(level)
    if level >= ESP_Settings.LevelThresholds.High then
        return ESP_Settings.ColorMaxLevel
    elseif level >= ESP_Settings.LevelThresholds.Mid then
        return ESP_Settings.ColorHighLevel
    elseif level >= ESP_Settings.LevelThresholds.Low then
        return ESP_Settings.ColorMidLevel
    else
        return ESP_Settings.ColorLowLevel
    end
end

-- Criar ESP para um jogador
local function createESP(player)
    if player == LocalPlayer or espCache[player] then return end
    
    -- Criar objetos Drawing
    local esp = {
        text = Drawing.new("Text"),
        distanceText = Drawing.new("Text"),
        box = Drawing.new("Square"),
        healthBar = Drawing.new("Square"),
        healthBarBG = Drawing.new("Square"),
        player = player,
        connection = nil
    }
    
    -- Configurar texto principal
    esp.text.Size = ESP_Settings.TextSize
    esp.text.Font = ESP_Settings.TextFont
    esp.text.Outline = ESP_Settings.TextOutline
    esp.text.Visible = false
    
    -- Configurar texto de distância
    esp.distanceText.Size = ESP_Settings.TextSize - 2
    esp.distanceText.Font = ESP_Settings.TextFont
    esp.distanceText.Outline = ESP_Settings.TextOutline
    esp.distanceText.Visible = false
    
    -- Configurar caixa
    esp.box.Thickness = 1
    esp.box.Filled = false
    esp.box.Visible = false
    
    -- Configurar barra de vida
    esp.healthBarBG.Thickness = 1
    esp.healthBarBG.Filled = true
    esp.healthBarBG.Visible = false
    esp.healthBarBG.Color = Color3.fromRGB(50, 50, 50)
    
    esp.healthBar.Thickness = 1
    esp.healthBar.Filled = true
    esp.healthBar.Visible = false
    esp.healthBar.Color = Color3.fromRGB(0, 255, 0)
    
    espCache[player] = esp
    
    -- Conexão de atualização
    esp.connection = RunService.RenderStepped:Connect(function()
        if not ESP_Settings.Enabled or not player or not player.Character then
            esp.text.Visible = false
            esp.distanceText.Visible = false
            esp.box.Visible = false
            esp.healthBar.Visible = false
            esp.healthBarBG.Visible = false
            return
        end
        
        local character = player.Character
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
        
        if not humanoid or not rootPart or humanoid.Health <= 0 then
            esp.text.Visible = false
            esp.distanceText.Visible = false
            esp.box.Visible = false
            esp.healthBar.Visible = false
            esp.healthBarBG.Visible = false
            return
        end
        
        -- Calcular posição na tela
        local position, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
        local distance = (rootPart.Position - Camera.CFrame.Position).Magnitude
        
        if onScreen and distance <= ESP_Settings.MaxDistance then
            -- Obter estatísticas
            local stats = getPlayerStats(player)
            
            -- Construir texto
            local textLines = {}
            
            if ESP_Settings.ShowName then
                table.insert(textLines, player.Name)
            end
            
            if ESP_Settings.ShowLevel then
                table.insert(textLines, "Level: " .. formatNumber(stats.level))
            end
            
            if ESP_Settings.ShowBounty and stats.bounty > 0 then
                table.insert(textLines, "Bounty: " .. formatNumber(stats.bounty))
            end
            
            if stats.frags > 0 then
                table.insert(textLines, "Frags: " .. stats.frags)
            end
            
            if stats.fruit ~= "?" then
                table.insert(textLines, "Fruit: " .. stats.fruit)
            end
            
            if stats.race ~= "?" then
                table.insert(textLines, "Race: " .. stats.race)
            end
            
            -- Aplicar cor baseada no level
            esp.text.Color = getLevelColor(stats.level)
            
            -- Definir texto
            esp.text.Text = table.concat(textLines, "\n")
            esp.text.Position = Vector2.new(position.X, position.Y - 50)
            esp.text.Visible = true
            
            -- Texto de distância
            if ESP_Settings.ShowDistance then
                esp.distanceText.Text = math.floor(distance) .. " studs"
                esp.distanceText.Position = Vector2.new(position.X, position.Y + 20)
                esp.distanceText.Color = Color3.fromRGB(200, 200, 200)
                esp.distanceText.Visible = true
            end
            
            -- Desenhar caixa
            local characterSize = character:GetExtentsSize()
            local width = 1000 / distance * 2
            local height = 2000 / distance * 2
            
            esp.box.Size = Vector2.new(width, height)
            esp.box.Position = Vector2.new(position.X - width/2, position.Y - height/2)
            esp.box.Color = getLevelColor(stats.level)
            esp.box.Visible = true
            
            -- Desenhar barra de vida
            local healthPercent = humanoid.Health / humanoid.MaxHealth
            local barWidth = 60
            local barHeight = 4
            local barX = position.X - barWidth/2
            local barY = position.Y - height/2 - 10
            
            esp.healthBarBG.Size = Vector2.new(barWidth, barHeight)
            esp.healthBarBG.Position = Vector2.new(barX, barY)
            esp.healthBarBG.Visible = true
            
            esp.healthBar.Size = Vector2.new(barWidth * healthPercent, barHeight)
            esp.healthBar.Position = Vector2.new(barX, barY)
            esp.healthBar.Color = Color3.fromRGB(
                math.floor(255 * (1 - healthPercent)),
                math.floor(255 * healthPercent),
                0
            )
            esp.healthBar.Visible = true
            
        else
            esp.text.Visible = false
            esp.distanceText.Visible = false
            esp.box.Visible = false
            esp.healthBar.Visible = false
            esp.healthBarBG.Visible = false
        end
    end)
    
    -- Limpar quando o jogador sair
    player.AncestryChanged:Connect(function()
        if not player:IsDescendantOf(Players) then
            if esp.connection then
                esp.connection:Disconnect()
            end
            if espCache[player] then
                esp.text:Remove()
                esp.distanceText:Remove()
                esp.box:Remove()
                esp.healthBar:Remove()
                esp.healthBarBG:Remove()
                espCache[player] = nil
            end
        end
    end)
end

-- Inicializar ESP para jogadores existentes
for _, player in ipairs(Players:GetPlayers()) do
    createESP(player)
end

-- Conectar para novos jogadores
Players.PlayerAdded:Connect(createESP)

-- Remover ESP quando jogador sair
Players.PlayerRemoving:Connect(function(player)
    if espCache[player] then
        if espCache[player].connection then
            espCache[player].connection:Disconnect()
        end
        espCache[player].text:Remove()
        espCache[player].distanceText:Remove()
        espCache[player].box:Remove()
        espCache[player].healthBar:Remove()
        espCache[player].healthBarBG:Remove()
        espCache[player] = nil
    end
end)

-- Interface de controle (opcional)
local function createGUI()
    -- Esta função pode ser expandida para criar uma interface gráfica
    print("ESP para Blox Fruits carregado!")
    print("Configurações:")
    print("- Max Distance: " .. ESP_Settings.MaxDistance)
    print("- Mostrar Level: " .. tostring(ESP_Settings.ShowLevel))
    print("- Mostrar Bounty: " .. tostring(ESP_Settings.ShowBounty))
    print("Use loadstring para reconfigurar.")
end

-- Comandos úteis
local commands = {
    ["esp_toggle"] = function()
        ESP_Settings.Enabled = not ESP_Settings.Enabled
        print("ESP " .. (ESP_Settings.Enabled and "ativado" or "desativado"))
    end,
    
    ["esp_distance"] = function(value)
        local num = tonumber(value)
        if num then
            ESP_Settings.MaxDistance = num
            print("Distância máxima: " .. num)
        end
    end,
    
    ["esp_color"] = function()
        print("Cores do Level:")
        print("- Baixo (<500): Verde")
        print("- Médio (500-1000): Amarelo")
        print("- Alto (1000-2000): Vermelho")
        print("- Máximo (>2000): Magenta")
    end
}

-- Criar interface
createGUI()

-- Retornar funções de controle
return {
    Settings = ESP_Settings,
    Toggle = function() commands.esp_toggle() end,
    SetDistance = function(dist) commands.esp_distance(dist) end,
    Help = function()
        print("Comandos disponíveis:")
        print("ESP.Toggle() - Ativa/desativa o ESP")
        print("ESP.SetDistance(1000) - Define distância máxima")
        print("ESP.Help() - Mostra esta mensagem")
    end
}
